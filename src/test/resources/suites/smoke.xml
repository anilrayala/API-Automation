<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  The fast confidence check: is each API reachable and behaving on its main path?

    mvn clean test -DsuiteXmlFile=src/test/resources/suites/smoke.xml

  A smoke suite earns its keep by being fast enough to run on every commit, so keep it
  small. Add a test here only if its failure means "stop and look now".
-->
<suite name="API-Automation-Smoke" verbose="1" parallel="classes" thread-count="4">

    <listeners>
        <listener class-name="org.api.automation.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
                <exclude name="requires-credentials"/>
                <exclude name="needs-verification"/>
            </run>
        </groups>
        <packages>
            <package name="org.api.automation.tests.*"/>
        </packages>
    </test>

</suite>
